<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.stackcraft</groupId>
    <artifactId>retroflow</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>retroflow</name>
    <description>RetroFlow backend API for StackCraft's internal retrospective tool</description>

    <properties>
        <java.version>21</java.version>
        <jacoco.version>0.8.12</jacoco.version>
        <!-- Minimum line coverage enforced by `mvn verify` (0.80 = 80%) -->
        <jacoco.minimum.coverage>0.80</jacoco.minimum.coverage>
        <!-- Mutation testing; versions checked on Maven Central (latest releases, no known CVEs) -->
        <pitest.version>1.30.1</pitest.version>
        <pitest.junit5.version>1.2.3</pitest.junit5.version>
        <!--
          Byte Buddy (used by Mockito in the @WebMvcTest tests) as managed by Spring Boot 3.3.4 is 1.14.19,
          which only supports up to Java 23: on a Java 25 JDK every test that mocks fails. 1.18.16 is the
          latest release (checked on Maven Central, no known CVEs) and supports Java 25. Overrides both
          byte-buddy and byte-buddy-agent through Spring Boot's dependency management. Remove when Spring
          Boot is upgraded to a version that manages a Java-25-capable Byte Buddy itself.
        -->
        <byte-buddy.version>1.18.16</byte-buddy.version>
        <!-- Architecture tests; latest release, checked on Maven Central, no known CVEs -->
        <archunit.version>1.5.1</archunit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Local dev only: automatic restart on recompile. Excluded from the packaged jar. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Turns the layering rules into tests (ArchitectureTest): not managed by Spring Boot -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <!-- Bootstrap class only contains main(); not meaningful to cover -->
                        <exclude>com/stackcraft/retroflow/RetroflowApplication.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <!-- Attach the JaCoCo agent to Surefire via the argLine property -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <!-- Generate HTML/XML/CSV reports in target/site/jacoco (runs before check) -->
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- Fail the build when line coverage is below the threshold -->
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.minimum.coverage}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
              Mutation testing (PIT). Not bound to a phase, so `mvn verify` stays fast. Run on demand:
                ./mvnw test-compile org.pitest:pitest-maven:mutationCoverage
              Report: target/pit-reports/index.html (and mutations.xml)
              Scope: the service layer (where the business rules live) and the tests that target it.
            -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pitest.version}</version>
                <dependencies>
                    <!-- Lets PIT run JUnit 5 tests -->
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>${pitest.junit5.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>com.stackcraft.retroflow.service.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>com.stackcraft.retroflow.service.*Test</param>
                        <param>com.stackcraft.retroflow.RetroflowBusinessRulesTest</param>
                    </targetTests>
                    <outputFormats>
                        <param>HTML</param>
                        <param>XML</param>
                    </outputFormats>
                    <timestampedReports>false</timestampedReports>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
